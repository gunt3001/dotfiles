{
  "$schema": "https://raw.githubusercontent.com/LGUG2Z/komorebi/v0.1.36/schema.json",
  "animation": {
    "enabled": true,
    "fps": 120,
    "style": "EaseInOutCubic",
    "duration": 160
  },
  "app_specific_configuration_path": "C:/Users/gun/.config/komorebi/applications.json",
  "window_hiding_behaviour": "Cloak",
  "cross_monitor_move_behaviour": "Insert",
  "default_workspace_padding": 0,
  "default_container_padding": -1,
  "border": false,
  "theme": {
    "palette": "Catppuccin",
    "name": "Mocha"
  },
  "mouse_follows_focus": false,
  "monitors": [
    {
      {{- if .is_ultrawide }}
      "workspaces": [
        {
          "name": "1",
          "layout": "UltrawideVerticalStack"
        },
        {
          "name": "2",
          "layout": "UltrawideVerticalStack"
        },
        {
          "name": "3",
          "layout": "UltrawideVerticalStack"
        },
        {
          "name": "4",
          "layout": "UltrawideVerticalStack"
        },
        {
          "name": "5",
          "layout": "UltrawideVerticalStack"
        },
        {
          "name": "6",
          "layout": "UltrawideVerticalStack"
        },
        {
          "name": "7",
          "layout": "UltrawideVerticalStack"
        },
        {
          "name": "8",
          "layout": "UltrawideVerticalStack"
        },
        {
          "name": "9",
          "layout": "UltrawideVerticalStack"
        }
      ]
      {{- else }}
      "workspaces": [
        {
          "name": "1",
          "layout": "BSP"
        },
        {
          "name": "2",
          "layout": "BSP"
        },
        {
          "name": "3",
          "layout": "BSP"
        },
        {
          "name": "4",
          "layout": "BSP"
        },
        {
          "name": "5",
          "layout": "BSP"
        },
        {
          "name": "6",
          "layout": "BSP"
        },
        {
          "name": "7",
          "layout": "BSP"
        },
        {
          "name": "8",
          "layout": "BSP"
        },
        {
          "name": "9",
          "layout": "BSP"
        }
      ]
      {{- end }}
    }
  ],
  "manage_rules": [
    {
      "kind": "Title",
      "id": "Affinity Photo",
      "matching_strategy": "Equals"
    },
    {
      "kind": "Exe",
      "id": "Taiga.exe",
      "matching_strategy": "Equals"
    },
    {
      "kind": "Exe",
      "id": "gakumas.exe",
      "matching_strategy": "Equals"
    }
  ],
  "floating_applications": [
    {
      "kind": "Exe",
      "id": "LunaTranslator.exe",
      "matching_strategy": "Equals"
    },
    [
      {
        "kind": "Exe",
        "id": "StreamDeck.exe",
        "matching_strategy": "Equals"
      },
      {
        "kind": "Class",
        "id": "Qt693QWindow",
        "matching_strategy": "Equals"
      }
    ]
  ]
}
